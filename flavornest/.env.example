# Server
PORT=8080
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8080

# MongoDB (local or Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/flavornest

# Auth - sessions (cookie-based, stored in MongoDB). Optional: the app has a
# safe built-in default if you leave this as-is or remove it. Set a real
# random string before deploying anywhere public.
SESSION_SECRET=change_this_to_a_long_random_string

# First account to register with this email is auto-promoted to admin
ADMIN_EMAIL=admin@flavornest.com

# Stripe (test mode). Leave unset / as-is to run checkout in mock-payment mode
# with no Stripe account needed - useful for local dev and demos.
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_PUBLISHABLE_KEY=pk_test_mock

# Order pricing
CURRENCY=usd
TAX_RATE=0.05
DELIVERY_FEE=2.99
FREE_DELIVERY_THRESHOLD=25

# Email (SMTP). Leave SMTP_HOST unset to run in mock mode - emails are logged
# to the console (and saved for admin viewing) instead of actually sent.
# Any standard SMTP provider works: Gmail app password, Mailtrap, SendGrid, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FlavorNest <no-reply@flavornest.com>"

# Used to build links inside emails (password reset, etc.)
APP_URL=http://localhost:8080
