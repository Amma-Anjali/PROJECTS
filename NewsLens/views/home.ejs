<%- include('partials/header') %>

<% if (!featured && (!articles || articles.length === 0)) { %>
  <div class="empty-state">
    <h2>No articles yet</h2>
    <p>Run <code>npm run seed</code> to pull in the first batch of news, then refresh this page.</p>
  </div>
<% } else { %>

  <% if (featured) { %>
  <section class="featured">
    <a href="/news/<%= featured._id %>" class="featured-media">
      <% if (featured.image) { %>
        <img src="<%= featured.image %>" alt="" referrerpolicy="no-referrer"
          onerror="this.closest('.featured-media').style.display='none'">
      <% } %>
    </a>
    <div class="featured-body">
      <span class="category-tag" data-cat="<%= featured.category.toLowerCase() %>"><%= featured.category %></span>
      <h2><a href="/news/<%= featured._id %>"><%= featured.title %></a></h2>
      <p class="desc"><%= featured.description %></p>
      <span class="meta-line"><%= featured.source %> &middot; <%= featured.timeAgo %> &middot; <%= featured.readingTime %> min read</span>
    </div>
  </section>
  <% } %>

  <section>
    <h2 class="section-heading">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z" opacity="0"/><path d="M19 20H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9l5 5v9a2 2 0 0 1-2 2z"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg>
      Latest
    </h2>
    <div class="story-grid">
      <% articles.forEach(function(article) { %>
        <%- include('partials/articleCard', { article: article }) %>
      <% }) %>
    </div>
  </section>

<% } %>

<%- include('partials/footer') %>
